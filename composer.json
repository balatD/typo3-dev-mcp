{
    "name": "balatd/typo3-dev-mcp",
    "description": "AI development helper for TYPO3 v13/v14 — an MCP server exposing TCA, database schema, sites, TypoScript, logs and the core changelog to Claude Code and other MCP clients. Inspired by laravel/boost.",
    "license": "MIT",
    "type": "typo3-cms-extension",
    "keywords": [
        "typo3",
        "mcp",
        "ai",
        "development",
        "claude"
    ],
    "require": {
        "php": "^8.2",
        "mcp/sdk": "^0.7",
        "typo3/cms-core": "^13.4 || ^14.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "typo3/coding-standards": "^0.8",
        "typo3/testing-framework": "^9.0 || ^10.0"
    },
    "autoload": {
        "psr-4": {
            "BalatD\\DevMcp\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BalatD\\DevMcp\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "scripts": {
        "cgl": "php-cs-fixer fix",
        "stan": "phpstan analyse Classes --level=8",
        "test:unit": "phpunit -c Tests/UnitTests.xml"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "dev_mcp"
        }
    }
}
