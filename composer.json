{
    "name": "balatd/typo3-dev-mcp",
    "description": "AI development helper for TYPO3 v13/v14 \u2014 an MCP server exposing TCA, database schema, sites, TypoScript, logs and the core changelog to Claude Code and other MCP clients. Inspired by laravel/boost.",
    "license": "MIT",
    "type": "typo3-cms-extension",
    "homepage": "https://github.com/balatD/typo3-dev-mcp",
    "authors": [
        {
            "name": "Dragan Balatinac",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/balatD/typo3-dev-mcp/issues",
        "source": "https://github.com/balatD/typo3-dev-mcp"
    },
    "keywords": [
        "typo3",
        "mcp",
        "ai",
        "development",
        "claude"
    ],
    "require": {
        "php": "^8.2",
        "mcp/sdk": "^0.7.1 || ^0.8",
        "typo3/cms-core": "^13.4 || ^14.0"
    },
    "require-dev": {
        "friendsoftypo3/content-blocks": "^1.6 || ^2.4",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "typo3/cms-fluid-styled-content": "^13.4 || ^14.0",
        "typo3/cms-tstemplate": "^13.4 || ^14.0",
        "typo3/coding-standards": "^0.8",
        "typo3/tailor": "^2.0",
        "typo3/testing-framework": "^9.6 || ^10.0"
    },
    "autoload": {
        "psr-4": {
            "BalatD\\DevMcp\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BalatD\\DevMcp\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "scripts": {
        "bench": "Tests/Benchmark/bin/run.sh",
        "bench:report": "php Tests/Benchmark/bin/report.php",
        "bench:setup": "Tests/Benchmark/bin/setup-bench.sh",
        "bench:tax": "Tests/Benchmark/bin/tax.sh",
        "bench:verify": "Tests/Benchmark/bin/verify-arms.sh",
        "cgl": "php-cs-fixer fix",
        "cgl:check": "php-cs-fixer fix --dry-run --diff",
        "stan": "phpstan analyse",
        "test:functional": "phpunit -c Tests/FunctionalTests.xml",
        "test:unit": "phpunit -c Tests/UnitTests.xml"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "dev_mcp",
            "version": "1.0.0",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
